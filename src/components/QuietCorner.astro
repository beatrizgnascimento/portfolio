  @keyframes hold { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(1px); } }
  @keyframes concentrate { 0%, 100% { transform: rotate(0); } 50% { transform: rotate(-1.4deg); } }
  @keyframes blink { 0%, 44%, 47%, 100% { transform: scaleY(1); } 45.5% { transform: scaleY(.05); } }
  @keyframes tail { 0%, 100% { transform: rotate(-3deg); } 50% { transform: rotate(5deg); } }
  @keyframes steam { 0%, 100% { transform: translateY(2px); opacity: .25; } 50% { transform: translateY(-5px); opacity: .65; } }
  @keyframes cursor { 0%, 50% { opacity: 1; } 51%, 100% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) {
    .study-cat * { animation: none; }
  }
</style>
