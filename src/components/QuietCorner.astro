<!-- Hand-drawn silhouette, oversized eyes and coffee inspired by the user's reference. -->
<svg class="study-cat" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 370 300" fill="none" stroke="currentColor" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round">
  <!-- Small, dangling body and a long arm around the oversized coffee cup. -->
  <path d="M130 170c-7 16-6 36-5 48l1 27c2 8 14-9 20-19l9 19c6 8 16-14 18-27l4-28 65 18 9-24-68-19" fill="var(--paper)" />
  <path class="cat-tail" d="M128 202c-19-10-25 3-18 10 6 5 13-2 9-6" stroke-width="2.8" />

  <!-- Large mug, with imperfect marker-like contours and a dark coffee surface. -->
  <g class="coffee-cup">
    <!-- A closed handle sits behind the cup so both ends join its body. -->
    <path d="M321 157c47-19 55 91-6 90l3-22c32 5 38-62 4-49Z" fill="var(--paper)" />
    <path d="M251 136c1 28 0 67 4 97 2 13 51 22 64 9 7-15 7-77 8-106" fill="var(--paper)" />
    <path d="M252 140c-11-9 2-16 33-15 27 1 47 4 41 13" />
    <path d="M257 137c10-7 52-5 65 1-15 8-51 9-65-1Z" fill="currentColor" stroke-width="1.4" />
    <path d="m262 229 1 7m49-58-1 41" stroke-width="1.2" opacity=".45" />
    <path class="coffee-steam steam-one" d="M273 111c-9-11 10-17 2-29" stroke-width="2" />
    <path class="coffee-steam steam-two" d="M294 111c-8-10 9-15 2-26" stroke-width="2" />
  </g>

  <g class="cat-head">
    <!-- Uneven pointed ears and a broad, low face follow the reference silhouette. -->
    <path d="M101 113c-3-12-1-23 2-36l4-21 22 22c15-6 33-8 52-5l27-29 10 42c15 28 16 53 0 71-14 18-36 23-57 22-25-1-43-12-55-32-8-13-10-24-5-34Z" fill="var(--paper)" />
    <path d="m102 132-24-17m26 29-31-4m35 13-26 10m140-32 24-17m-22 29 24-4m-26 14 20 7" stroke-width="2.8" />
    <!-- Matching eye shapes and pupil offsets keep both eyes looking at the laptop. -->
    <g stroke-width="1.7">
      <path d="M106 128c18-9 38-2 45 12 8 15-6 33-23 31-15-2-23-15-24-28-1-9 0-9 2-15Z" />
      <path d="M106 128c18-9 38-2 45 12 8 15-6 33-23 31-15-2-23-15-24-28-1-9 0-9 2-15Z" transform="translate(64 -3)" />
      <path d="M152 141q8-5 16-2" />
    </g>
    <g class="cat-eyes">
      <ellipse cx="125" cy="150" rx="12" ry="17" transform="rotate(18 125 150)" fill="currentColor" stroke="none" />
      <ellipse cx="189" cy="147" rx="12" ry="17" transform="rotate(18 189 147)" fill="currentColor" stroke="none" />
    </g>
    <path d="m155 168 5 3 4-4" stroke-width="1.8" />
  </g>

  <!-- The second paw hugs the mug, as in the reference. -->
  <g class="coffee-paw">
    <path d="m239 175 16-2c9-1 14 3 13 10-1 6-9 10-24 10l-5-18Z" fill="var(--paper)" stroke-width="3" />
  </g>

  <!-- A compact laptop keeps the cat, rather than the computer, as the focal point. -->
  <path d="m19 172 70 7 18 53-70-8Zm9 9 54 5 12 35-52-5Z" fill="var(--paper)" stroke-width="2.8" />
  <path class="screen-lines" d="m40 193 11 1m5 1 14 1m-27 7 30 4m-26 6 15 1" stroke-width="1.5" />
  <path class="screen-cursor" d="m69 215 7 1" stroke-width="2" />
  <path d="m37 224 70 8 31 18-76-8Zm25 18 1 5 73 9 2-6" fill="var(--paper)" stroke-width="2.7" />
  <path d="m56 231 44 5 14 9-47-6Zm9 4 42 5m-32-7 8 8m7-6 8 8" stroke-width="1.1" />
  <!-- A small arm and paw rest on the keyboard. -->
  <g class="typing-paw">
    <path d="M124 183c-5 12-13 25-23 37l-12 9c-7 7-3 13 8 13 10-1 18-8 24-14l17-23" fill="var(--paper)" stroke-width="3.1" />
    <path d="m94 230 3 6m3-9 3 6" stroke-width="1.3" />
  </g>
  <path d="m45 267 83 4m121-7 68 2" stroke="var(--faint)" stroke-width="1.2" stroke-dasharray=".2 5" />
</svg>

<style>
  .study-cat { overflow: visible; color: var(--ink); }
  .coffee-steam { opacity: .45; }
</style>
